---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Projects from '../components/Projects.astro';
import Blog from '../components/Blog.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import FloatingButtons from '../components/FloatingButtons.astro';
import '../styles/global.css';
---

<Layout
  title="Pablo Alcalde García - Software Engineer | IA & Full-Stack | Granada"
  description="Software Engineer especializado en IA aplicada, LLMs y desarrollo full-stack. Actualmente en UST desarrollando soluciones con Ollama, FastAPI y Astro. Anteriormente Frontend Developer en Wegow."
  tags={["software engineer", "IA aplicada", "LLMs", "Ollama", "FastAPI", "Astro", "Vue.js", "Nuxt.js", "Granada", "UST", "full-stack"]}
>
  <Header />
  <main>
    <Hero />
    <About />
    <Experience />
    <Skills />
    <Education />
    <Projects />
    <Blog />
    <Contact />
  </main>
  <Footer />
  <FloatingButtons />
</Layout>

