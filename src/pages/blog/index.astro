function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout
  title="Blog de Pablo Alcalde García | IA, LLMs, Frontend y SEO | España"
  description="Artículos técnicos sobre IA aplicada, LLMs, Ollama, desarrollo frontend con Vue.js, Nuxt y Astro, SEO y entrevistas tech. Por Pablo Alcalde García, Software Engineer en España."
  tags={["Pablo Alcalde García", "blog tecnología España", "inteligencia artificial", "LLMs", "Ollama", "desarrollo frontend", "Vue.js", "Nuxt.js", "Astro", "SEO", "JavaScript", "TypeScript", "software engineer España"]}
>
  <Header />

  <!-- Structured Data: Blog -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Blog",
    "name": "Blog de Pablo Alcalde García",
    "description": "Artículos técnicos sobre IA aplicada, LLMs, desarrollo frontend, SEO y entrevistas tech por Pablo Alcalde García, Software Engineer en España.",
    "url": "https://pabloalcalde.dev/blog",
    "author": {
      "@type": "Person",
      "name": "Pablo Alcalde García",
      "jobTitle": "Software Engineer",
      "url": "https://pabloalcalde.dev",
      "sameAs": [
        "https://www.linkedin.com/in/pabloalcaldegarcia",
        "https://github.com/paablooag"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "UST",
        "url": "https://www.ust.com"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Granada",
        "addressRegion": "Andalucía",
        "addressCountry": "ES"
      }
    },
    "publisher": {
      "@type": "Person",
      "name": "Pablo Alcalde García",
      "url": "https://pabloalcalde.dev"
    },
    "inLanguage": "es-ES",
    "about": ["Inteligencia Artificial", "LLMs", "Ollama", "FastAPI", "Vue.js", "Nuxt.js", "Astro", "SEO", "Desarrollo Frontend", "Entrevistas Tech"]
  })} />

  <main class="pt-24">
    <section class="section">
      <div class="container-custom">
        <!-- Hero del Blog -->
        <div class="text-center mb-16">
          <h1 class="text-5xl md:text-6xl font-bold mb-4">
            {t('blog.title')} <span class="gradient-text">{t('blog.titleHighlight')}</span>
          </h1>
          <p class="text-xl text-gray-400 max-w-2xl mx-auto">
            {t('blog.subtitle')}
          </p>
        </div>

        <!-- Filtros -->
        <div class="mb-12 space-y-6">
          <!-- Buscador -->
          <div class="w-full">
            <label for="search-input" class="block text-sm font-medium text-gray-300 mb-2">
              {t('blog.filters.search')}
            </label>
            <div class="relative">
              <input 
                type="text"
                id="search-input"
                placeholder={t('blog.filters.searchPlaceholder')}
                class="w-full bg-gray-800 border border-gray-700 text-white px-4 py-3 pl-12 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 hover:border-gray-600"
              />
              <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <!-- Filtros y contador -->
          <div class="flex flex-col md:flex-row gap-6 items-start md:items-center justify-between">
            <div class="w-full md:w-auto md:min-w-[300px]">
              <label for="category-filter" class="block text-sm font-medium text-gray-300 mb-2">
                {t('blog.filters.title')}
              </label>
              <div class="relative">
                <select 
                  id="category-filter"
                  class="w-full appearance-none bg-gray-800 border border-gray-700 text-white px-4 py-3 pr-10 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 cursor-pointer hover:border-gray-600"
                >
                  <option value="all">{t('blog.filters.all')} ({sortedPosts.length})</option>
                  {allCategories.map((category: string) => {
                    const count = sortedPosts.filter(post => post.data.tags.includes(category)).length;
                    const filterKey = categoryMap[category as keyof typeof categoryMap] || category.toLowerCase().replace(/\s+/g, '');
                    return (
                      <option value={category}>
                        {t(`blog.filters.${filterKey}`) || category} ({count})
                      </option>
                    );
                  })}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </div>
              </div>
            </div>
            
            <!-- Filtro por fecha -->
            <div class="w-full md:w-auto md:min-w-[250px]">
              <label for="date-filter" class="block text-sm font-medium text-gray-300 mb-2">
                {t('blog.filters.date-filter')}
              </label>
              <div class="relative">
                <select 
                  id="date-filter"
                  class="w-full appearance-none bg-gray-800 border border-gray-700 text-white px-4 py-3 pr-10 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all duration-300 cursor-pointer hover:border-gray-600"
                >
                  <option value="all">{t('blog.filters.all-time')}</option>
                  <option value="month">{t('blog.filters.last-month')}</option>
                  <option value="3months">{t('blog.filters.last-3-months')}</option>
                  <option value="6months">{t('blog.filters.last-6-months')}</option>
                  <option value="year">{t('blog.filters.last-year')}</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              </div>
            </div>
            
            <!-- Contador de resultados -->
            <div class="flex items-center gap-3">
              <p id="results-count" class="text-gray-400 text-sm">
                {t('blog.showingResults').replace('{count}', sortedPosts.length.toString())}
              </p>
            </div>
          </div>
        </div>

        <!-- Grid de artículos -->
        <div id="articles-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <article 
              class="blog-post card group hover:scale-[1.02] transition-all duration-300" 
              data-tags={post.data.tags.join(',')}
              data-title={post.data.title.toLowerCase()}
              data-description={post.data.description.toLowerCase()}
              data-date={post.data.pubDate.toISOString()}
            >
              <div class="mb-4">
                <div class="flex flex-wrap gap-2 mb-3">
                  {post.data.tags.map((tag) => (
                    <span class="post-tag text-xs px-3 py-1 bg-primary/20 text-primary rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
                <h2 class="text-xl font-bold text-white mb-2 group-hover:text-primary transition-colors">
                  <a href={`/blog/${post.slug}`}>
                    {post.data.title}
                  </a>
                </h2>
                <p class="text-gray-400 text-sm mb-3">
                  {post.data.description}
                </p>
                <div class="flex items-center gap-2 text-gray-500 text-xs mb-4">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                  </svg>
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate)}
                  </time>
                </div>
              </div>
              <a 
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-2 text-primary hover:gap-3 transition-all duration-300"
              >
                {t('blog.readMore')}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </article>
          ))}
        </div>

        <!-- Mensaje si no hay resultados -->
        <div id="no-results" class="card text-center py-12 hidden">
          <div class="mb-4 text-5xl">🔍</div>
          <p class="text-gray-400 text-lg mb-2">
            {t('blog.noResults')}
          </p>
          <button id="reset-filters" class="mt-4 text-primary hover:text-secondary transition-colors">
            {t('blog.filters.all')}
          </button>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingButtons />
</Layout>

<script is:inline>
  // Script optimizado para producción con filtro por fecha
  (function() {
    'use strict';
    
    function init() {
      var categoryFilter = document.getElementById('category-filter');
      var searchInput = document.getElementById('search-input');
      var dateFilter = document.getElementById('date-filter');
      var blogPosts = document.querySelectorAll('.blog-post');
      var resultsCount = document.getElementById('results-count');
      var noResults = document.getElementById('no-results');
      var articlesGrid = document.getElementById('articles-grid');
      var resetButton = document.getElementById('reset-filters');
      
      if (!blogPosts.length) return;
      
      var lang = document.documentElement.lang || 'es';
      var showingText = lang === 'es' ? 'Mostrando {count} artículos' : 'Showing {count} articles';

      function getDateRange(period) {
        var now = new Date();
        var range = new Date();
        
        switch(period) {
          case 'month':
            range.setMonth(now.getMonth() - 1);
            break;
          case '3months':
            range.setMonth(now.getMonth() - 3);
            break;
          case '6months':
            range.setMonth(now.getMonth() - 6);
            break;
          case 'year':
            range.setFullYear(now.getFullYear() - 1);
            break;
          default:
            return null;
        }
        
        return range;
      }

      function filterPosts() {
        var category = categoryFilter ? categoryFilter.value : 'all';
        var searchTerm = searchInput ? searchInput.value.toLowerCase().trim() : '';
        var datePeriod = dateFilter ? dateFilter.value : 'all';
        var dateRange = getDateRange(datePeriod);
        var visibleCount = 0;
        
        for (var i = 0; i < blogPosts.length; i++) {
          var post = blogPosts[i];
          var tags = post.dataset.tags ? post.dataset.tags.split(',') : [];
          var title = post.dataset.title || '';
          var description = post.dataset.description || '';
          var postDate = post.dataset.date ? new Date(post.dataset.date) : null;
          
          // Filtrar por categoría
          var matchesCategory = category === 'all' || tags.indexOf(category) !== -1;
          
          // Filtrar por búsqueda
          var matchesSearch = searchTerm === '' || 
            title.indexOf(searchTerm) !== -1 || 
            description.indexOf(searchTerm) !== -1;
          
          // Filtrar por fecha
          var matchesDate = !dateRange || !postDate || postDate >= dateRange;
          
          if (matchesCategory && matchesSearch && matchesDate) {
            post.style.display = 'block';
            post.style.opacity = '1';
            post.style.transform = 'scale(1)';
            visibleCount++;
          } else {
            post.style.opacity = '0';
            post.style.transform = 'scale(0.95)';
            setTimeout((function(p) {
              return function() {
                p.style.display = 'none';
              };
            })(post), 300);
          }
        }
        
        // Actualizar contador
        if (resultsCount) {
          resultsCount.textContent = showingText.replace('{count}', visibleCount.toString());
        }
        
        // Mostrar/ocultar mensaje de sin resultados
        if (noResults && articlesGrid) {
          if (visibleCount === 0) {
            articlesGrid.style.display = 'none';
            noResults.classList.remove('hidden');
          } else {
            articlesGrid.style.display = 'grid';
            noResults.classList.add('hidden');
          }
        }
      }

      // Event listeners
      if (categoryFilter) {
        categoryFilter.addEventListener('change', filterPosts);
      }

      if (searchInput) {
        searchInput.addEventListener('input', filterPosts);
      }

      if (dateFilter) {
        dateFilter.addEventListener('change', filterPosts);
      }

      if (resetButton) {
        resetButton.addEventListener('click', function() {
          if (categoryFilter) categoryFilter.value = 'all';
          if (searchInput) searchInput.value = '';
          if (dateFilter) dateFilter.value = 'all';
          filterPosts();
        });
      }

      // Estilos para transiciones
      for (var i = 0; i < blogPosts.length; i++) {
        blogPosts[i].style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        blogPosts[i].style.opacity = '1';
        blogPosts[i].style.transform = 'scale(1)';
      }

      // Inicializar
      filterPosts();
    }
    
    // Inicializar cuando el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>


