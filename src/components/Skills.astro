---
import { getLangFromUrl, useTranslations } from '../utils/i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skills = {
  frontend: [
    { name: "Vue.js", level: 90 },
    { name: "Nuxt.js", level: 90 },
    { name: "Astro", level: 85 },
    { name: "JavaScript", level: 85 },
    { name: "HTML5", level: 95 },
    { name: "CSS3 / Tailwind", level: 90 }
  ],
  ai: [
    { name: "LLMs / IA Generativa", level: 80 },
    { name: "Ollama", level: 85 },
    { name: "Prompt Engineering", level: 80 },
    { name: "FastAPI", level: 75 },
    { name: "Python", level: 75 },
    { name: "Optimización de pipelines IA", level: 78 }
  ],
  tools: [
    { name: "Git", level: 85 },
    { name: "Scrum / Agile", level: 85 },
    { name: "Jira / Taiga", level: 80 },
    { name: "VS Code", level: 95 },
    { name: "APIs REST", level: 80 },
    { name: "SEO Técnico", level: 85 }
  ]
};

const certifications = [
  "Ciberseguridad en puesto de trabajo",
  "Gestión de Proyectos y Fundamentos de metodología Agile",
  "Curso de SEO y Posicionamiento web para Desarrolladores web",
  "Digitalización de negocio con Google y comunicación YouTube y Google Forms"
];
---

<section id="habilidades" class="section bg-dark-lighter">
  <div class="container-custom">
    <h2 class="text-4xl md:text-5xl font-bold text-center mb-12">
      {t('skills.title')} <span class="gradient-text">{t('skills.titleHighlight')}</span>
    </h2>
    
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <!-- Frontend -->
      <div class="card">
        <h3 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <span class="text-3xl">⚡</span>
          {t('skills.frontend')}
        </h3>
        <div class="space-y-4">
          {skills.frontend.map((skill) => (
            <div>
              <div class="flex justify-between mb-2">
                <span class="text-gray-300">{skill.name}</span>
                <span class="text-primary font-semibold">{skill.level}%</span>
              </div>
              <div class="h-2 bg-dark rounded-full overflow-hidden">
                <div 
                  class="h-full bg-gradient-to-r from-primary to-secondary rounded-full transition-all duration-1000"
                  style={`width: ${skill.level}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- IA & Backend -->
      <div class="card">
        <h3 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <span class="text-3xl">🤖</span>
          IA & Backend
        </h3>
        <div class="space-y-4">
          {skills.ai.map((skill) => (
            <div>
              <div class="flex justify-between mb-2">
                <span class="text-gray-300">{skill.name}</span>
                <span class="text-secondary font-semibold">{skill.level}%</span>
              </div>
              <div class="h-2 bg-dark rounded-full overflow-hidden">
                <div
                  class="h-full bg-gradient-to-r from-secondary to-primary rounded-full transition-all duration-1000"
                  style={`width: ${skill.level}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Herramientas & Metodologías -->
      <div class="card">
        <h3 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <span class="text-3xl">🛠️</span>
          {t('skills.tools')}
        </h3>
        <div class="space-y-4">
          {skills.tools.map((skill) => (
            <div>
              <div class="flex justify-between mb-2">
                <span class="text-gray-300">{skill.name}</span>
                <span class="text-secondary font-semibold">{skill.level}%</span>
              </div>
              <div class="h-2 bg-dark rounded-full overflow-hidden">
                <div 
                  class="h-full bg-gradient-to-r from-secondary to-primary rounded-full transition-all duration-1000"
                  style={`width: ${skill.level}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Certificaciones -->
    <div class="card max-w-4xl mx-auto">
      <h3 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <span class="text-3xl">🏆</span>
        Certificaciones
      </h3>
      <div class="grid md:grid-cols-2 gap-4">
        {certifications.map((cert) => (
          <div class="flex items-start gap-2">
            <span class="text-primary mt-1">✓</span>
            <span class="text-gray-300">{cert}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

