# Configuración para SEO multilingüe
# Redireccionar www a no-www
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Configuración de idioma por defecto
# Si no se especifica idioma, redirigir a español
RewriteCond %{REQUEST_URI} !^/en/
RewriteCond %{REQUEST_URI} !^/en$
RewriteCond %{REQUEST_URI} !^/blog/
RewriteCond %{REQUEST_URI} !^/proyectos/
RewriteCond %{REQUEST_URI} !^/robots\.txt$
RewriteCond %{REQUEST_URI} !^/sitemap.*\.xml$
RewriteCond %{REQUEST_URI} !^/manifest\.json$
RewriteCond %{REQUEST_URI} !^/favicon\.ico$
RewriteCond %{REQUEST_URI} !^/logo-.*\.png$
RewriteCond %{REQUEST_URI} !^/og-image\.svg$
RewriteCond %{REQUEST_URI} !^/projects-sitemap\.xml$
RewriteCond %{REQUEST_URI} !^/src/
RewriteCond %{REQUEST_URI} !^/node_modules/
RewriteCond %{REQUEST_URI} !^/\.astro/
RewriteCond %{REQUEST_URI} !^/dist/
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteCond %{REQUEST_URI} !^/index\.html$
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.*)$ /$1 [L]

# Headers para SEO
<IfModule mod_headers.c>
    # Cache headers para sitemaps
    <FilesMatch "\.(xml)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    
    # Cache headers para imágenes
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    
    # Cache headers para CSS y JS
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

# Compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Configuración de tipos MIME
<IfModule mod_mime.c>
    AddType application/xml .xml
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType image/webp .webp
</IfModule>